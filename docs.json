{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Passionfruit Docs",
  "colors": {
    "primary": "#5B5B5B",
    "light": "#F0F0F0",
    "dark": "#000000"
  },
  "appearance": {
    "default": "light",
    "dark": true,
    "light": true
  },

  "background": {
    "color": {
      "dark": "#0C0C0B",
      "light": "#FDFDFC"
    }
  },
  "style": {
    "border": {
      "dark": "rgba(255, 255, 255, 0.04)",
      "light": "rgba(0, 0, 0, 0.04)"
    },
    "hover": {
      "dark": "#1A1A1A",
      "light": "#F0F0F0"
    }
  },
  "favicon": "/icons/favicon.svg",
  "meta": {
    "image": "/images/workspace/entra-passionfruit-integration.png",
    "title": "Passionfruit Docs",
    "description": "Your hub for building, integrating, and staying up to date with Passionfruit."
  },
  "css": ["/docs/custom.css"],
  "redirects": [
    {
      "source": "/docs/fill-questionnaires/search-context",
      "destination": "/docs/fill-questionnaires/search-configuration"
    },
    {
      "source": "/docs/fill-questionnaires/select-search-context",
      "destination": "/docs/fill-questionnaires/search-configuration"
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "collapsed": true,
        "groups": [
          {
            "group": "Getting Started",
            "icon": "rocket",
            "pages": [
              "docs/installation/start-guide",
              "docs/installation/apps",
              "docs/installation/install"
            ]
          },
          {
            "group": "Workspace",
            "icon": "buildings",
            "collapsed": true,
            "pages": [
              "docs/installation/profile",
              "docs/installation/organisation",
              "docs/installation/sso"
            ]
          },

          {
            "group": "Integrations",
            "icon": "plug",
            "collapsed": true,
            "pages": [
              "docs/sharepoint",
              "docs/google-drive",
              "docs/custom-integrations"
            ]
          },
          {
            "group": "Analytics",
            "icon": "chart-line-up",
            "collapsed": true,
            "pages": ["docs/analytics/insights"]
          }
        ],
        "global": {
          "anchors": [
            {
              "anchor": "Blog",
              "href": "https://passionfruit.earth/resources",
              "icon": "newspaper"
            }
          ]
        }
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hello@passionfruit.earth"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.passionfruit.earth"
    }
  },
  "integrations": {
    "posthog": {
      "apiKey": "phc_WlP73lAq2O6cnyR3IHwu9D2M3c1kQZeqPcldSxV8sAr",
      "apiHost": "https://eu.posthog.com",
      "sessionRecording": true
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/passionfruit",
      "github": "https://github.com/passionfruit",
      "linkedin": "https://linkedin.com/company/passionfruit"
    }
  }
}
